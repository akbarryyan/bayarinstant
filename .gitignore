# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# user-uploaded images (persisted on the server, not tracked in git)
# Subfolders themselves ARE tracked (via .gitkeep) so they always exist on disk
# before the Next.js server boots — next start snapshots public/ subdirectories
# at startup and won't discover a folder created later by mkdir() at upload time.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/*/
/public/uploads/*/*
!/public/uploads/*/.gitkeep

# server logs (persisted on the server, not tracked in git)
# Direktori itu sendiri di-track lewat .gitkeep supaya sudah eksis dengan
# permission yang benar sebelum server boot.
/logs/*
!/logs/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local planning docs (not for push)
/docs/superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts
